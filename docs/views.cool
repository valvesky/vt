COOL void head(char *title) {
    <head>
        <title>{ title }</title>
        <link rel="stylesheet" href="style.css">
    </head>
}

COOL void footer() {
    <footer>
        copyright @ Vasco Alves 2026
    </footer>
}

COOL void page(char *title, void(*func)(char *), char *p) {
    <!DOCTYPE html>
    <html>
        @head(title)
        <body>
            <main>
                @func(p)
            </main>
            @footer()
        </body>
    </html>
}
