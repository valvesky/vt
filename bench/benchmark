# 	devnull_sum=$(awk -v a="$devnull_sum" -v b="$t" 'BEGIN { printf "%.6f", a + b }')
# done
# DEVNULL_AVERAGE=$(awk -v m="$MIB" -v n="$ROUNDS" -v t="$devnull_sum" \
# 	'BEGIN { printf "%.2f", (m * n) / t }')

printf 'ASCII_AVERAGE    %s MiB/s\n' "$ASCII_AVERAGE" >&2
