#!/usr/bin/env bash
# Dump 1 GiB to this terminal's stdout. Run me inside the terminal under test.
# Averages go to stderr so they are not part of the payload.
set -euo pipefail

ROUNDS=10
MIB=1024

DIR=$(mktemp -d)
trap 'rm -rf "$DIR"' EXIT

echo "generating ${MIB} MiB payloads in $DIR" >&2
dd if=/dev/urandom of="$DIR/garbage.bin" bs=1M count="$MIB" status=none
tr '\000-\037\177-\377' '.' <"$DIR/garbage.bin" >"$DIR/ascii.bin"

elapsed() {
	local start end

	start=$(date +%s.%N)
	cat "$1"
	end=$(date +%s.%N)
	awk -v s="$start" -v e="$end" 'BEGIN { printf "%.6f", e - s }'
}

mib_s() {
	awk -v m="$MIB" -v t="$1" 'BEGIN { printf "%.2f", m / t }'
}

ascii_sum=0
devnull_sum=0

echo "ASCII  ${MIB} MiB x ${ROUNDS}  → stdout" >&2
for ((i = 1; i <= ROUNDS; i++)); do
	t=$(elapsed "$DIR/ascii.bin")
	echo "  round $i  ${t}s  $(mib_s "$t") MiB/s" >&2
	ascii_sum=$(awk -v a="$ascii_sum" -v b="$t" 'BEGIN { printf "%.6f", a + b }')
done
ASCII_AVERAGE=$(awk -v m="$MIB" -v n="$ROUNDS" -v t="$ascii_sum" \
	'BEGIN { printf "%.2f", (m * n) / t }')

# echo "DEVNULL  ${MIB} MiB x ${ROUNDS}  → stdout" >&2
