diff --git a/src/vt_sixel.c b/src/vt_sixel.c
new file mode 100644
index 0000000..ae4bebc
--- /dev/null
+++ b/src/vt_sixel.c
@@ -0,0 +1,74 @@
+#pragma once
+
+/*
+ * Sixel is DCS (ESC P … q … ST). Term cannot take it: str_buf is 128 bytes
+ * and term_feed_escape requires a complete sequence. The ring is 16 pages.
+ * Stream the payload here and drop it. Decode / blit comes later.
+ */
+
+static int vt_sixel_payload;
+
+static int vt_sixel_in_payload(void);
+static u32 vt_sixel_intro_len(const char *p, u32 n);
+static u32 vt_sixel_st_len(const char *p, u32 n, int *ended);
+static void vt_sixel_set_payload(int on);
+
+int
+vt_sixel_in_payload(void)
+{
+  return vt_sixel_payload;
+}
+
+void
+vt_sixel_set_payload(int on)
+{
+  vt_sixel_payload = on ? 1 : 0;
+}
+
+u32
+vt_sixel_intro_len(const char *p, u32 n)
+{
+  u32 i;
+
+  if (n < 3 || (unsigned char)p[0] != 0x1B || p[1] != 'P')
+    return 0;
+  for (i = 2; i < n; i++) {
+    unsigned char b;
+
+    b = (unsigned char)p[i];
+    if (b >= 0x30 && b <= 0x3F)
+      continue;
+    if (b == 'q')
+      return i + 1;
+    return 0;
+  }
+  return 0;
+}
+
+u32
+vt_sixel_st_len(const char *p, u32 n, int *ended)
+{
+  u32 i;
+
+  *ended = 0;
+  i = 0;
+  while (i < n) {
+    unsigned char b;
+
+    b = (unsigned char)p[i];
+    if (b == 0x07) {
+      *ended = 1;
+      return i + 1;
+    }
+    if (b == 0x1B) {
+      if (i + 1 >= n)
+        return i;
+      if (p[i + 1] == '\\') {
+        *ended = 1;
+        return i + 2;
+      }
+    }
+    i++;
+  }
+  return i;
+}
