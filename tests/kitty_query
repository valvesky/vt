#!/usr/bin/env python3
"""Live a=q reply: icat detect needs OK before DA."""
import json
import os
import socket
import subprocess
import sys
import time

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
CMD = (
    "python3 -c "
    "'import os,select,termios,tty,sys;"
    "fd=0;old=termios.tcgetattr(fd);tty.setraw(fd);"
    "os.write(1,bytes.fromhex(\"1b5f47693d33312c733d312c763d312c613d712c743d642c663d32343b414141411b5c1b5b63\"));"
    "r,_,_=select.select([0],[],[],2);"
    "d=os.read(0,128) if r else b\"\";"
    "termios.tcsetattr(fd,termios.TCSADRAIN,old);"
    "sys.stdout.buffer.write(b\"GOT \"+d.hex().encode()+b\"\\n\")'"
    "\r"
)


def fail(msg):
    sys.stderr.write("FAIL tests/kitty_query: %s\n" % msg)
    sys.exit(1)


def sock_path(pid):
    rt = os.environ.get("XDG_RUNTIME_DIR", "")
    if rt:
        return os.path.join(rt, "vt", "%d.sock" % pid)
    return "/tmp/vt-%d/%d.sock" % (os.getuid(), pid)


def rpc(path, obj, timeout=8):
    last = None
    t0 = time.time()
    while time.time() - t0 < 2:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(timeout)
        try:
            s.connect(path)
            break
        except OSError as e:
            last = e
            s.close()
            time.sleep(0.05)
    else:
        raise RuntimeError("connect %s: %s" % (path, last))
    try:
        s.sendall((json.dumps(obj, separators=(",", ":")) + "\n").encode())
        s.shutdown(socket.SHUT_WR)
        data = b""
        while True:
            try:
                chunk = s.recv(65536)
            except TimeoutError:
                break
            if not chunk:
                break
            data += chunk
    finally:
        s.close()
    if not data:
        raise RuntimeError("empty reply %s" % obj.get("op"))
    parsed, _ = json.JSONDecoder().raw_decode(data.decode())
    if not parsed.get("ok", True) and "ev" not in parsed:
        raise RuntimeError("ctl error %s" % parsed)
    return parsed


def main():
    bin_path = os.path.join(ROOT, "vt-live")
    if os.path.isfile(os.path.join(ROOT, "vt-live.exe")):
        bin_path = os.path.join(ROOT, "vt-live.exe")
    if not os.path.isfile(bin_path):
        fail("./vt-live not built")
    proc = subprocess.Popen(
        [bin_path, "--cols", "80", "--rows", "24"],
        cwd=ROOT,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    path = sock_path(proc.pid)
    try:
        t0 = time.time()
        while time.time() - t0 < 10:
            if proc.poll() is not None:
                fail("vt exited %s before ctl socket" % proc.returncode)
            if os.path.exists(path):
                time.sleep(0.1)
                break
            time.sleep(0.05)
        else:
            fail("ctl socket not created")
        t0 = time.time()
        text = ""
        while time.time() - t0 < 8:
            text = rpc(path, {"op": "dump"}).get("text") or ""
            if "$" in text or "#" in text:
                break
            time.sleep(0.05)
        else:
            fail("no shell prompt")
        rpc(path, {"op": "write", "data": CMD})
        t0 = time.time()
        dump = ""
        while time.time() - t0 < 8:
            dump = rpc(path, {"op": "dump"}).get("text") or ""
            if "1b5f47693d33313b4f4b" in dump.replace("\n", "").replace(" ", ""):
                print("ok tests/kitty_query")
                return
            time.sleep(0.05)
        fail("no i=31;OK in dump %r" % dump)
    finally:
        if proc.poll() is None:
            proc.terminate()
            try:
                proc.wait(timeout=3)
            except subprocess.TimeoutExpired:
                proc.kill()
                proc.wait()


if __name__ == "__main__":
    main()
